---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base current="home" title="OneTech Solutions — أنظمة أتمتة وذكاء اصطناعي بالعربية" description="OneTech Solutions تبني أنظمة أتمتة مدعومة بالذكاء الاصطناعي تعمل بالعربية: استقبال عملائك على قنواتهم، تنبيهات الطلبات والمخزون، ومساعد يجيب عن أسئلة زبائنك من ملفاتك.">

	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<h1>أنظمة تشغيل ذكية ترد على عملائك وتنظّم طلباتك وتوفّر وقت فريقك.</h1>
				<p class="lead">
					OneTech Solutions تبني أنظمة أتمتة مدعومة بالذكاء الاصطناعي تعمل بالعربية، وتبدأ بثلاث خدمات:
					استقبال عملائك على قنواتهم، تنبيهات الطلبات والمخزون، ومساعد يجيب عن أسئلة زبائنك من ملفاتك.
					أما التركيب المحلي والعمل دون إنترنت فمرحلة قادمة ضمن خارطة الطريق.
				</p>
				<ul class="benefits">
					<li>رد أسرع على عملائك على القنوات التي يستخدمونها</li>
					<li>أخطاء أقل في الطلبات والفواتير والمخزون</li>
					<li>وقت موفَّر لفريقك كل شهر، تقيسه أرقام قبل وبعد</li>
				</ul>
				<a class="cta" href="#contact">احجز جلسة اكتشاف مجانية</a>
				<p class="cta-note">نصف ساعة نفهم فيها عمليتك ونخبرك بصراحة إن كانت الأتمتة تناسبك.</p>
			</div>
			<div class="hero-flow" role="img" aria-label="مخطط توضيحي لطريقة العمل: رسالة العميل تدخل النظام فتخرج ردًا تلقائيًا أو تنبيه مخزون أو تقريرًا يوميًا">
				<div class="flow-title" aria-hidden="true">كيف يعمل النظام؟</div>
				<div class="flow-node" aria-hidden="true"><span class="dot"></span><div>عميلك يراسلك على قناته<small>واتساب أو القناة التي تعتمدها</small></div></div>
				<div class="flow-arrow" aria-hidden="true"><svg width="16" height="20" viewBox="0 0 16 20" fill="none"><path d="M8 1v14m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
				<div class="flow-node" aria-hidden="true"><span class="dot"></span><div>نظام OneTech يستقبل ويعالج<small>فرز الطلب ومطابقته مع ملفاتك وسياساتك</small></div></div>
				<div class="flow-arrow" aria-hidden="true"><svg width="16" height="20" viewBox="0 0 16 20" fill="none"><path d="M8 1v14m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
				<div class="flow-outcomes" aria-hidden="true">
					<span>رد تلقائي على العميل</span>
					<span>تنبيه عند نقص المخزون</span>
					<span>تقرير يومي موجز</span>
				</div>
			</div>
		</div>
	</section>

	<section id="offers">
		<div class="wrap">
			<div class="eyebrow">خدمات الإطلاق</div>
			<h2>ثلاث خدمات في خطة الإطلاق</h2>
			<p class="section-sub">نبدأ بما يحل مشكلة يومية واحدة بوضوح، ونقيس النتيجة قبل أي توسع.</p>
			<div class="cards">
				<div class="card">
					<Icon name="chat" />
					<h3>استقبال العملاء على قنواتهم</h3>
					<p>قناة تواصل، فجدول عملاء، فرد تلقائي، فمتابعة، فتقرير يومي — لتقليل الرسائل الضائعة والعملاء المنتظرين بلا جواب.</p>
				</div>
				<div class="card">
					<Icon name="bell" />
					<h3>تنبيهات الطلبات والمخزون</h3>
					<p>إشعار بكل طلب جديد، وتنبيه عند نقص صنف قبل أن تكتشفه متأخرًا.</p>
				</div>
				<div class="card">
					<Icon name="spark" />
					<h3>مساعد ذكاء اصطناعي عربي</h3>
					<p>يجيب عن أسئلة زبائنك المتكررة من ملف أسعارك وسياساتك أنت، بالعربية.</p>
				</div>
			</div>
			<div class="roadmap-note">
				تجربتك الأولى مشروع تجريبي محدد النطاق يبدأ من <b>300$</b> محليًا، بعرض مكتوب يوضح السعر والمدة قبل أي التزام.
			</div>
		</div>
	</section>

	<section id="how" class="soft">
		<div class="wrap">
			<div class="eyebrow">منهجيتنا</div>
			<h2>كيف نعمل</h2>
			<p class="section-sub">أربع خطوات واضحة، بلا التزام قبل أن تعرف الجدوى.</p>
			<ol class="steps">
				<li><div><b>جلسة اكتشاف مجانية</b><span>نصف ساعة نفهم فيها عمليتك اليومية ونقيس وقتها وتكلفتها الحالية.</span></div></li>
				<li><div><b>توصية صريحة</b><span>نخبرك بصراحة إن كانت الأتمتة تناسبك، ونحسب معك العائد المتوقع قبل أن تدفع.</span></div></li>
				<li><div><b>عرض واضح</b><span>نطاق محدد ومدة محددة وتجربة أولى قصيرة، بلا مفاجآت.</span></div></li>
				<li><div><b>قياس قبل وبعد</b><span>أرقام حقيقية من نشاطك: وقت الرد، الأخطاء، والساعات الموفَّرة.</span></div></li>
			</ol>
			<div class="roadmap-note">
				<b>نصمم للفشل:</b> لكل أتمتة نبنيها تنبيهُ فشل فوري وخطة يدوية بديلة، لأن الإنترنت والكهرباء والقنوات قد تتعطل. النظام يخدم عملك، لا يعطّله.
			</div>
		</div>
	</section>

	<section id="roadmap">
		<div class="wrap">
			<div class="eyebrow">خارطة الطريق</div>
			<h2>مراحل خدماتنا</h2>
			<p class="section-sub">نرتّب التطور مراحل مدروسة بدل أن نعد بكل شيء دفعة واحدة.</p>
			<div class="cards">
				<div class="card">
					<h3>المستويات 1–4 <span class="badge later">مرحلة الإطلاق</span></h3>
					<p>استقبال العملاء، تنظيم الطلبات والفواتير، التقارير اليومية، ولوحة تحكم بسيطة، مع أولى لمسات الذكاء الاصطناعي: تصنيف واستخراج، ومساعد عربي يجيب من ملفات شركتك.</p>
				</div>
				<div class="card">
					<h3>المستويات المتقدمة <span class="badge later">خارطة طريق</span></h3>
					<p>معالجة المستندات المتقدمة، أنظمة القطاعات الجاهزة، الوكلاء الأذكياء، والتركيب المحلي والعمل دون إنترنت — مراحل قادمة تُفتح بعد نجاح المرحلة الأولى.</p>
				</div>
			</div>
			<div class="roadmap-note">
				هذه عروض مرحلة الإطلاق في خطتنا، وتُعتمد تفاصيل كل خدمة وشروطها عند التعاقد. وكل مستوى أعلى يُعلن عند جهوزه فعليًا، لا قبل ذلك.
			</div>
		</div>
	</section>

	<CtaBand />

</Base>
