---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base current="services" title="الخدمات — OneTech Solutions" description="عائلات خدمات الأتمتة الخمس: من أتمتة المهام البسيطة إلى أنظمة الذكاء الاصطناعي، مرتبة من الأسهل إلى الأصعب.">

	<section class="page-hero">
		<div class="wrap">
			<div class="eyebrow rv">خدماتنا</div>
			<h1>خدماتنا: من أتمتة مهمة واحدة إلى منظومة كاملة</h1>
			<p>خمس عائلات خدمات مرتبة من الأسهل إلى الأصعب. نبدأ معك من المستوى الذي يحل مشكلتك اليوم، وننتقل للأعلى عندما تثبت النتيجة.</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2 class="rv">عائلة الأتمتة <span class="badge later">مرحلة الإطلاق</span></h2>
			<p class="section-sub rv">المستويات 1–4 مع أولى لمسات الذكاء الاصطناعي من المستوى 5: أساس كل مشروع، وأول ما نقدمه في خطة الإطلاق.</p>
			<div class="cards rv-stagger">
				<div class="card">
					<Icon name="bolt" />
					<h3>أتمتة مهمة واحدة</h3>
					<p>خطوة متكررة واحدة تبدأ بحدث وتنتهي بإجراء: طلب جديد يصلك إشعاره، مرفق يُحفظ تلقائيًا، تنبيه عند نقص صنف.</p>
				</div>
				<div class="card">
					<Icon name="flow" />
					<h3>أتمتة مسار عمل</h3>
					<p>سلسلة خطوات مترابطة: من استلام الطلب إلى تسجيله إلى إشعار الفريق، دون نقل يدوي بين التطبيقات.</p>
				</div>
				<div class="card">
					<Icon name="chat" />
					<h3>استقبال العملاء والمبيعات</h3>
					<p>قناة تواصل، فجدول عملاء، فرد تلقائي، فمتابعة، فتقرير يومي — لتقليل الرسائل الضائعة والعملاء المنتظرين بلا جواب.</p>
				</div>
				<div class="card">
					<Icon name="chart" />
					<h3>التكامل والبيانات والتقارير</h3>
					<p>ربط أنظمتك الحالية ولوحة تحكم بسيطة ترى فيها أرقامك اليومية في مكان واحد.</p>
				</div>
				<div class="card">
					<Icon name="spark" />
					<h3>أتمتة مدعومة بالذكاء الاصطناعي <span class="badge later">مرحلة الإطلاق — جزئيًا</span></h3>
					<p>تبدأ ضمن الإطلاق بلمسات أولى: تصنيف وتلخيص واستخراج النصوص، ومساعد عربي يجيب من ملفات شركتك. أما معالجة المستندات المتقدمة والصور فمرحلة تالية.</p>
				</div>
			</div>
			<div class="roadmap-note rv">
				هذه عروض مرحلة الإطلاق في خطتنا، وتُعتمد تفاصيل كل خدمة وشروطها عند التعاقد. ويبدأ المشروع التجريبي محدد النطاق من <b>300$</b> محليًا، ويُقدَّم السعر النهائي في عرض مكتوب واضح بعد جلسة الاكتشاف.
			</div>
		</div>
	</section>

	<section class="soft">
		<div class="wrap">
			<div class="eyebrow rv">الخريطة الكاملة</div>
			<h2 class="rv">تسعة مستويات من الأسهل إلى الأصعب</h2>
			<p class="section-sub rv">كتالوج خدماتنا مرتب حسب التعقيد. تبدأ معك من المستوى الذي يحل مشكلتك اليوم، وننتقل للأعلى عندما تثبت النتيجة.</p>
			<div class="ladder rv" aria-label="مستويات خدمات الأتمتة التسعة">
				<div class="lvl on"><b>1</b><small>مهمة واحدة</small></div>
				<div class="lvl on"><b>2</b><small>مسار عمل</small></div>
				<div class="lvl on"><b>3</b><small>استقبال العملاء</small></div>
				<div class="lvl on"><b>4</b><small>تكامل وتقارير</small></div>
				<div class="lvl"><b>5</b><small>أتمتة ذكية</small></div>
				<div class="lvl"><b>6</b><small>نظام بأتمتة</small></div>
				<div class="lvl"><b>7</b><small>نظام بأتمتة ذكية</small></div>
				<div class="lvl"><b>8</b><small>وكلاء ذكاء اصطناعي</small></div>
				<div class="lvl"><b>9</b><small>أتمتة شاملة</small></div>
			</div>
			<div class="ladder-legend rv">
				<span><i class="i-on"></i> مرحلة الإطلاق — متاحة الآن</span>
				<span><i class="i-next"></i> خارطة طريق — تُعلن عند جهوزها</span>
			</div>
			<div class="roadmap-note rv">
				تقابل هذه المستويات أنواع الأتمتة المعروفة من أتمتة المهام وسير العمل في المستويات من 1 إلى 4 إلى الأتمتة الذكية ومعالجة المستندات في المستوى 5 إلى الأنظمة والتطبيقات بأتمتة مدمجة في المستويين 6 و7 إلى وكلاء الذكاء الاصطناعي والأتمتة الشاملة في المستويين 8 و9
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2 class="rv">العائلات التالية <span class="badge later">خارطة طريق</span></h2>
			<p class="section-sub rv">معالجة المستندات المتقدمة (5ب) وما فوقها: مراحل قادمة تُفتح بعد نجاح المرحلة الأولى، ويُعلن عن كل مستوى عند جهوزه فعليًا.</p>
			<div class="cards rv-stagger">
				<div class="card">
					<Icon name="layers" />
					<h3>تطبيقات بأتمتة وأتمتة ذكية</h3>
					<p>شاشات مخصصة لموظفيك بصلاحيات، فوق أتمتة كاملة لعملياتك، مع ذكاء اصطناعي اختياري.</p>
				</div>
				<div class="card">
					<Icon name="globe" />
					<h3>منظومات الوكلاء والأتمتة الشاملة</h3>
					<p>وكلاء ذكاء اصطناعي يتخذون إجراءات متعددة الخطوات، وأتمتة شاملة للمؤسسة على مراحل.</p>
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2 class="rv">خدمات داعمة</h2>
			<p class="section-sub rv">خدمات تكميلية تمنح مشروع الأتمتة واجهته الواضحة: ما يراه عميلك، وما يربط أنظمتك في مسار واحد.</p>
			<div class="cards rv-stagger">
				<div class="card"><Icon name="code" /><h3>واجهات وبوابات للأنظمة</h3><p>بوابة طلبات لعملائك، صفحة حجز، لوحة متابعة لموظفيك: واجهات واضحة فوق أنظمة الأتمتة التي نبنيها لك.</p></div>
				<div class="card"><Icon name="pen" /><h3>تصميم وهوية</h3><p>هوية بصرية وواجهات واضحة تعكس نشاطك.</p></div>
			</div>
		</div>
	</section>

	<section class="soft">
		<div class="wrap">
			<div class="eyebrow rv">تحت الغطاء</div>
			<h2 class="rv">كيف نبني هذه الأنظمة تقنيًا</h2>
			<p class="section-sub rv">منصات مرئية أم كود مخصص وأين يعمل النظام وأي التقنيات لأي دور صفحة كيف نبني تشرح منهجيتنا التقنية كاملة طرق البناء الأربع والتصميم الهجين وأماكن التشغيل وأدوار التقنيات وخطواتنا العشر من الفكرة إلى التشغيل</p>
			<a class="link-more rv" href="/methodology">اقرأ المنهجية التقنية كيف نبني أنظمة الأتمتة ←</a>
		</div>
	</section>

	<CtaBand />

</Base>

