---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base current="" title="الشروط — OneTech Solutions" description="شروط التعامل مع OneTech Solutions: العرض المكتوب أساس الالتزام، شروط الدفع والاشتراك، تكاليف الأطراف الثالثة، وحدود المسؤولية.">

	<section class="page-hero">
		<div class="wrap">
			<div class="eyebrow rv">الشروط</div>
			<h1>شروط التعامل</h1>
			<p>بلا مفاجآت: ما نلتزم به نكتبه، وما نكتبه نلتزم به. آخر تحديث: نوفمبر 2026.</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2 class="rv">العرض المكتوب هو الأساس</h2>
			<p class="section-sub" style="max-width:70ch">
				كل مشروع يبدأ بعرض مكتوب يوضح النطاق والسعر والمدة والمخاطر قبل أي التزام. المحتوى على هذا الموقع تعريفي
				بخدمات مرحلة الإطلاق، وتُعتمد تفاصيل كل خدمة وشروطها عند التعاقد. أي تغيير في النطاق بعد بدء العمل يتم
				بطلب تغيير مكتوب يُسعَّر ويُعتمد قبل تنفيذه.
			</p>

			<h2 class="rv">الدفع</h2>
			<ul class="steps-plain">
				<li>المشاريع الصغيرة والمتوسطة: 50% مقدمًا و50% عند التسليم.</li>
				<li>المشاريع الأكبر: دفعات على مراحل مثبتة، تُحدد في العرض المكتوب.</li>
				<li>وسائل الدفع المتاحة محليًا تُذكر في العرض: شام كاش، سيرياتيل كاش، MTN كاش، تحويل بنكي، أو نقدًا بإيصال.</li>
			</ul>

			<h2 class="rv">الاشتراك الشهري</h2>
			<ul class="steps-plain">
				<li>اختياري في أول 30 يومًا ضمن فترة الدعم المجانية بعد التسليم، ثم يُعتمد باتفاق مكتوب.</li>
				<li>يشمل مراقبة التشغيل وتنبيه الأعطال وإصلاحها وتعديلات صغيرة ضمن سقف ساعات الباقة، مع تقرير شهري بما عمله النظام.</li>
				<li>التأخر في الدفع الشهري أكثر من 15 يومًا يتيح تعليق الدعم، وأكثر من 30 يومًا تعليق التشغيل المُدار، وفق العقد.</li>
			</ul>

			<h2 class="rv">تكاليف الأطراف الثالثة</h2>
			<p class="section-sub" style="max-width:70ch">
				تكاليف الاستضافة والنطاقات واستهلاك نماذج الذكاء الاصطناعي ورسائل القنوات وأي تراخيص خارجية لا تدخل في سعر
				البناء، وتُحدد كتابيًا في العرض: إما على حسابك مباشرة بحسابك الخاص، أو ضمن الاشتراك بسقف شهري واضح.
			</p>

			<h2 class="rv">حدود المسؤولية</h2>
			<ul class="steps-plain">
				<li>نصمم كل أتمتة بتنبيه فشل وخطة يدوية بديلة، لكننا لا نملك استمرارية القنوات الخارجية أو الكهرباء أو الإنترنت، ولا نضمنها.</li>
				<li>الأرقام والأمثلة التوضيحية على الموقع لشرح المنهجية، وهي موسومة بذلك وليست وعدًا بنتيجة محددة؛ نتيجتك تُقاس من نشاطك وتُكتب في تقريرك.</li>
				<li>العروض والمدد المذكورة على الموقع إرشادية لمرحلة الإطلاق، والملزم هو العرض المكتوب الموقع بيننا.</li>
			</ul>

			<h2 class="rv">تعديل هذه الشروط</h2>
			<p class="section-sub" style="max-width:70ch">
				عند أي تعديل جوهري نحدّث هذه الصفحة ونذكر تاريخ آخر تحديث في أعلاها، ولا يسري التعديل على عقود قائمة إلا باتفاق الطرفين.
			</p>
		</div>
	</section>

	<CtaBand />

</Base>

