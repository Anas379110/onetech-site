---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Base current="audiences" title="للعيادات والمكاتب — OneTech Solutions" description="أنظمة أتمتة للعيادات والمكاتب: حجز وتذكير تلقائي يقلل الغياب، متابعة لا تنسى أي عميل محتمل، ورد فوري على الاستفسارات المتكررة — مع التزام مكتوب بسرية البيانات.">

	<section class="page-hero">
		<div class="wrap">
			<div class="eyebrow">قطاع العيادات والمكاتب</div>
			<h1>للعيادات والمكاتب: مواعيد أوضح، غياب أقل، ولا عميل يُنسى</h1>
			<p>حجوزاتك بالهاتف والرسائل، ومتابعتك يدوية. نبني لك نظامًا ينظم المواعيد ويذكّر المراجعين ويتابع العملاء المحتملين، مع حماية بيانات عملائك ومرضاك أولًا.</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>المشكلة التي نحلها</h2>
			<p class="section-sub">ما نسمعه من مديري العيادات والمكاتب قبل أي مشروع.</p>
			<ul class="steps-plain">
				<li>حجوزات متضاربة ومراجعون يغيبون بلا تذكير، فتضيع ساعات الدوام.</li>
				<li>عملاء محتملون سألوا ثم نُسوا، فتحولهم المتابعة المتأخرة إلى غيرك.</li>
				<li>ملفات وصور وعقود متفرقة بين الأجهزة والرسائل.</li>
				<li>نفس الأسئلة المتكررة تستهلك وقت فريقك كل يوم.</li>
			</ul>
		</div>
	</section>

	<section class="soft">
		<div class="wrap">
			<h2>من أين نبدأ معك</h2>
			<p class="section-sub">خدمات إطلاق تنظم يومك، ونقيس النتيجة قبل أي توسع.</p>
			<div class="cards">
				<div class="card">
					<Icon name="bell" />
					<h3>حجز وتذكير تلقائي</h3>
					<p>تنظيم المواعيد وتذكير المراجعين تلقائيًا قبل الموعد، لتقليل الغياب والحجوزات المتضاربة.</p>
				</div>
				<div class="card">
					<Icon name="chat" />
					<h3>متابعة العملاء المحتملين</h3>
					<p>كل استفسار يُسجَّل ويُتابَع في وقته: لا عميل محتمل يضيع لأن المتابعة تأخرت أو نُسيت.</p>
				</div>
				<div class="card">
					<Icon name="spark" />
					<h3>رد فوري على الأسئلة المتكررة</h3>
					<p>مساعد عربي يجيب عن الأسئلة المتكررة من سياساتك ومعلوماتك أنت: الدوام، الأسعار، التحضيرات قبل المراجعة.</p>
				</div>
			</div>
			<div class="roadmap-note">
				تجربتك الأولى مشروع تجريبي محدد النطاق يبدأ من <b>300$</b> محليًا، بعرض مكتوب يوضح السعر والمدة قبل أي التزام.
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>خصوصية بيانات عملائك ومرضاك أولًا</h2>
			<p class="section-sub" style="max-width:70ch">
				نلتزم مكتوبًا بسرية بياناتك، ونعمل بمبدأ الحد الأدنى من الصلاحيات وبيئة مستقلة لكل عميل، مع تقرير واضح
				بما يُرسل وما لا يُرسل. وللبيانات الأعلى حساسية، خيار التركيب المحلي والعمل دون إنترنت مرحلة قادمة ضمن
				خارطة الطريق تُعلن عند جهوزها فعليًا، ونناقش في جلسة الاكتشاف ما يناسب حساسية بياناتك اليوم.
			</p>
			<h2>ماذا بعد التجربة؟</h2>
			<p class="section-sub" style="max-width:70ch">
				عندما تثبت التجربة قيمتها بأرقام قبل وبعد، تكون الخطوة التالية مساعدًا عربيًا يعمل على ملفات مكتبك،
				ثم نظام حجوزات وملفات مخصص. كل خطوة تُفتح بعد نجاح التي قبلها، بعرض مكتوب جديد.
			</p>
		</div>
	</section>

	<CtaBand />

</Base>
