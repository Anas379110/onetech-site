---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Base current="audiences" title="للمتاجر والصيدليات والمطاعم — OneTech Solutions" description="أنظمة أتمتة للمتاجر والصيدليات والمطاعم: استقبال الطلبات من كل قنواتك وتنظيمها دون ضياع، وتنبيه عند نقص المخزون قبل أن تكتشفه متأخرًا.">

	<section class="page-hero">
		<div class="wrap">
			<div class="eyebrow">قطاع المتاجر والصيدليات</div>
			<h1>للمتاجر والصيدليات والمطاعم: كل رسالة تتحول إلى طلب مسجَّل</h1>
			<p>تستقبل طلباتك عبر واتساب والاتصال وفيسبوك وتسجلها على ورقة أو دفتر. نبني لك نظامًا يستقبل وينظم وينبه، فلا يضيع طلب ولا ينتظر زبون بلا جواب.</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>المشكلة التي نحلها</h2>
			<p class="section-sub">ما نسمعه من أصحاب المتاجر والصيدليات قبل أي مشروع.</p>
			<ul class="steps-plain">
				<li>رسائل كثيرة من قنوات متفرقة بلا ترتيب، وطلبات تُنسى في الزحام.</li>
				<li>لا تعرف كم زبونًا سأل اليوم وكم طلبًا ضاع بلا متابعة.</li>
				<li>المخزون يُراجع يدويًا، ونقص الأصناف يُكتشف بعد فوات الأوان.</li>
				<li>الرد يتأخر وأنت مشغول، والزبون الذي لا يُرَد عليه يذهب لغيرك.</li>
			</ul>
		</div>
	</section>

	<section class="soft">
		<div class="wrap">
			<h2>من أين نبدأ معك</h2>
			<p class="section-sub">ثلاث خدمات إطلاق تحل مشكلة يومية واحدة بوضوح، ونقيس النتيجة قبل أي توسع.</p>
			<div class="cards">
				<div class="card">
					<Icon name="chat" />
					<h3>استقبال العملاء على قنواتهم</h3>
					<p>قناة تواصل، فجدول عملاء، فرد تلقائي، فمتابعة، فتقرير يومي — لتقليل الرسائل الضائعة والعملاء المنتظرين بلا جواب.</p>
				</div>
				<div class="card">
					<Icon name="bell" />
					<h3>تنبيهات الطلبات والمخزون</h3>
					<p>إشعار بكل طلب جديد لحظة وصوله، وتنبيه عند نقص صنف قبل أن تكتشفه متأخرًا.</p>
				</div>
				<div class="card">
					<Icon name="spark" />
					<h3>مساعد ذكاء اصطناعي عربي</h3>
					<p>يجيب عن أسئلة زبائنك المتكررة من ملف أسعارك وسياساتك أنت، بالعربية.</p>
				</div>
			</div>
			<div class="roadmap-note">
				تجربتك الأولى مشروع تجريبي محدد النطاق يبدأ من <b>300$</b> محليًا، بعرض مكتوب يوضح السعر والمدة قبل أي التزام.
			</div>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>كيف نحسب الجدوى معك</h2>
			<p class="section-sub">مثال توضيحي من منهجيتنا في حساب العائد — أرقام افتراضية للشرح، وليست نتيجة عميل فعلي.</p>
			<p class="section-sub" style="max-width:70ch">
				موظف يقضي 40 ساعة شهريًا في نسخ الطلبات ومراجعة المخزون، بتكلفة 10$ للساعة: هذا 400$ شهريًا تضيع في عمل متكرر.
				أتمتة استقبال الطلبات وتنبيهات المخزون بنحو 600$ تأسيسًا و60$ اشتراكًا شهريًا تسترد تكلفتها في نحو شهرين،
				ويبقى صافي التوفير بعدها لك. في جلسة الاكتشاف نحسب هذا المثال نفسه على أرقام نشاطك أنت، ونخبرك بصراحة إن لم تكن الجدوى موجودة.
			</p>
			<h2>ماذا بعد التجربة؟</h2>
			<p class="section-sub" style="max-width:70ch">
				عندما تثبت التجربة قيمتها بأرقام قبل وبعد، تكون الخطوة التالية نظام طلبات ومخزون وفواتير متكامل، ثم تقارير أوسع
				ومساعد ذكي يعرف نشاطك. كل خطوة تُفتح بعد نجاح التي قبلها، بعرض مكتوب جديد.
			</p>
		</div>
	</section>

	<CtaBand />

</Base>
